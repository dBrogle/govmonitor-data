# api.data.gov keys are universal — one key works for BOTH Congress.gov and OpenFEC.
# Rate limits are per key, so add as many numbered keys as you have (CONGRESS_API_KEY_1,
# _2, _3, ...); the pipeline round-robins across them and runs one finance thread per key.
# Get keys at https://api.data.gov/signup/  (or https://api.congress.gov/sign-up/)
CONGRESS_API_KEY_1=put_key_here
CONGRESS_API_KEY_2=put_key_here
CONGRESS_API_KEY_3=put_key_here

OPENROUTER_API_KEY=put_key_here