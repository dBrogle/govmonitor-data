# ── Secrets ──────────────────────────────────────────────
.env
.env.*
!.env.example

# ── Python ───────────────────────────────────────────────
venv/
__pycache__/
*.py[cod]

# ── Regenerable API response cache (~2 GB) ───────────────
# CACHE_DIR = utils/../data  → raw Congress.gov / OpenFEC responses.
# Rebuilt from the APIs on demand; never source data.
/data/

# ── Pipeline run logs ────────────────────────────────────
*.log

# ── Local tool / OS state ────────────────────────────────
.claude/
.DS_Store

# ── Generated member portraits (public-domain; refetch via scripts/download_member_images.py) ──
member_images/

# ── Personal scratchpad — kept local, not published ──────
notes.txt

# ── Intentionally COMMITTED (do not ignore) ──────────────
# pipeline/output/   → the produced dataset (the open-data deliverable)
# config.json, candidates.json, requirements.txt, *.py, DATA_REFERENCE.md
