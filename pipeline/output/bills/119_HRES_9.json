    "summaries": [
      {
        "action_date": "2025-01-03",
        "action_desc": "Introduced in House",
        "text": "<p>This resolution reaffirms that the United States in not a party to the Rome Statute and does not recognize the jurisdiction of the International Criminal Court (ICC). &nbsp;The resolution also (1) condemns the ICC's issuance of arrest warrant applications for Israeli Prime Minister Benjamin Netanyahu and&nbsp;Israeli Minister of Defense Yoav Gallant, and (2) supports Israel's right to defend itself and its leaders from unwarranted international legal actions.&nbsp;</p>",
        "update_date": "2025-01-16T21:26:04Z"
      }
    ]
