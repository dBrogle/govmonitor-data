    "summaries": [
      {
        "action_date": "2025-09-16",
        "action_desc": "Introduced in House",
        "text": "<p>This resolution (1) condemns the assassination of Charles \"Charlie\" James Kirk and all forms of political violence; and (2) honors the life, leadership, and legacy of Charlie Kirk.</p>",
