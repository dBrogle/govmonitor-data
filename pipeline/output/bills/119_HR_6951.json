    "summaries": [
      {
        "action_date": "2026-01-06",
        "action_desc": "Introduced in House",
        "text": "<p><strong>Stop Unfair Medicaid Recoveries Act&nbsp;</strong></p><p>This bill prohibits state Medicaid programs from using estate recovery to recoup the costs of benefits. States must withdraw property liens within 90 days of the bill's enactment and notify affected individuals of the&nbsp;withdrawals.</p>",
        "update_date": "2026-01-26T16:49:01Z"
      }
    ]
