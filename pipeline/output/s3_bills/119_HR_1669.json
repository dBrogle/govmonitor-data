    "summaries": [
      {
        "action_date": "2025-11-18",
        "action_desc": "Reported to House",
        "text": "<p>This bill reauthorizes through FY2030 the Stop, Observe, Ask, and Respond (SOAR) to Health and Wellness Training Program, which is administered by the National Human Trafficking Training and Technical Assistance Center in the Department of Health and Human Services. The program provides training for health care and social service providers on how to identify and support those who have experienced or are at risk of experiencing human trafficking.</p>",
        "update_date": "2026-04-02T19:27:29Z"
      }
