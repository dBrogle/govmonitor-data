      {
        "action_date": "2025-06-05",
        "action_desc": "Introduced in House",
        "text": "<p><strong>Forgotten Funds Act</strong></p><p>This bill rescinds the&nbsp;unobligated balances of discretionary appropriations that were provided for FY2021 or any previous fiscal year. It also requires the rescinded funds to be deposited into the Treasury for the sole purpose of deficit reduction.&nbsp;</p>",
        "update_date": "2025-07-22T13:19:25Z"
      }
    ]
