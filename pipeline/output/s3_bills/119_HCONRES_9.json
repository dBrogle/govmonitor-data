    "summaries": [
      {
        "action_date": "2025-02-06",
        "action_desc": "Introduced in House",
        "text": "<p>This concurrent resolution authorizes the National Fraternal Order of Police to sponsor two public events on Capitol grounds: the 44th Annual National Peace Officers Memorial Service (on&nbsp;May 15, 2025), and the National Honor Guard and Pipe Band Exhibition (on May 14, 2025). The concurrent resolution also authorizes the Speaker of the House and the Committee on Rules and Administration of the Senate to&nbsp;jointly designate alternate dates.&nbsp;</p>",
        "update_date": "2025-03-17T16:17:13Z"
      }
    ]
