    "summaries": [
      {
        "action_date": "2025-01-13",
        "action_desc": "Introduced in House",
        "text": "<p>This bill modifies the Infrastructure Investment and Jobs Act to allow unobligated balances of amounts made available to the Bureau of Reclamation for western water infrastructure to be made available to Reclamation for FY2026-2031 to provide financial or technical assistance for (1) groundwater recharge projects, (2) aquifer storage and recovery projects, or (3) water source substitution for aquifer protection projects.</p>",
        "update_date": "2025-04-02T14:49:42Z"
