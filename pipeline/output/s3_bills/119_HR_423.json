    "summaries": [
      {
        "action_date": "2025-01-15",
        "action_desc": "Introduced in House",
        "text": "<p><strong>Private Student Loan Bankruptcy Fairness Act of 2025 </strong></p><p>This bill modifies the treatment of certain student loans in bankruptcy.</p><p>Specifically, it allows&nbsp;private student loans to be discharged in bankruptcy&nbsp;regardless of whether&nbsp;a debtor&nbsp;demonstrates&nbsp;undue hardship.&nbsp;Under current law,&nbsp;student loans may be discharged in bankruptcy only if the loans impose an undue hardship on the debtor.</p>",
        "update_date": "2025-03-28T15:27:01Z"
      }
    ]
  },
