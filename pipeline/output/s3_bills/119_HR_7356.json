    "summaries": [
      {
        "action_date": "2026-02-04",
        "action_desc": "Introduced in House",
        "text": "<p><strong>No Federal Funds for Ballot Harvesting Act</strong></p> <p>This bill requires each state, in order to receive federal funds for election administration, to prohibit the knowing collection and transmission of a ballot in a federal election that was mailed to another person (commonly referred to as ballot harvesting), with exceptions.</p>",
        "update_date": "2026-04-10T13:45:54Z"
      }
    ]
