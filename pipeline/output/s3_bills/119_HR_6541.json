    "summaries": [
      {
        "action_date": "2025-12-09",
        "action_desc": "Introduced in House",
        "text": "<p><strong>Regulation A+ Improvement Act of 2025</strong></p><p>This bill increases the aggregate dollar limit of certain securities offerings exempt from registration requirements (i.e., Regulation A+ offerings) from $50 million annually to $150 million annually, adjusted in future years for inflation.</p>",
        "update_date": "2026-04-06T18:40:04Z"
      }
