    "summaries": [
      {
        "action_date": "2025-02-06",
        "action_desc": "Introduced in House",
        "text": "<p>This bill allows a national of the Czech Republic to qualify for E-1 nonimmigrant status if the Czech Republic provides similar nonimmigrant status to U.S. nationals. E-1 classification allows nationals of certain countries (i.e., those with a treaty of commerce and navigation with the United States, those under a qualifying international agreement, or those deemed to qualify through statute) to be admitted solely to engage in international trade, along with their families and employees.</p>",
        "update_date": "2026-02-26T15:27:01Z"
      }
    ]
