        "action_date": "2025-02-04",
        "action_desc": "Introduced in House",
        "text": "<p><strong>Non-Recognition of Russian Annexation of Ukrainian Territory Act </strong></p><p>This bill prohibits any federal agency from taking any action or extending any assistance that implies recognition of Russia's claim of sovereignty over any internationally recognized territory of Ukraine, including its airspace and territorial waters.</p>",
        "update_date": "2025-04-07T16:54:32Z"
      }
