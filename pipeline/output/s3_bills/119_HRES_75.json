    "summaries": [
      {
        "action_date": "2025-01-28",
        "action_desc": "Introduced in House",
        "text": "<p>This resolution recognizes the cultural and historical significance of the Lunar New Year.</p><p>The resolution expresses, in observance of this Lunar New Year, the Year of the Snake, the deepest respect of the House of Representatives for Asian Americans and all individuals throughout the world who celebrate this significant occasion.</p><p>The resolution wishes Asian Americans and all individuals who observe this holiday a happy and prosperous new year.</p>",
        "update_date": "2025-07-12T20:46:03Z"
      }
    ]
