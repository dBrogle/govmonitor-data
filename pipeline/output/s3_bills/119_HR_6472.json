    "summaries": [
      {
        "action_date": "2026-02-11",
        "action_desc": "Reported to House",
        "text": "<p><strong>Territorial Student Access to Higher Education Act</strong></p><p>This bill requires public institutions of higher education that participate in federal student aid programs to charge no more than in-state tuition and fee rates to students who&nbsp;are residents of Guam, the Northern Mariana Islands, American Samoa, or the U.S. Virgin Islands, provided they are also U.S. nationals.</p>",
        "update_date": "2026-02-26T19:37:33Z"
      }
    ]
