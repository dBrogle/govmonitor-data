    "summaries": [
      {
        "action_date": "2025-07-10",
        "action_desc": "Introduced in House",
        "text": "<p>This resolution commends and congratulates Petty Officer Third Class Scott&nbsp;Ruskan for his bravery and heroic efforts to rescue 165 victims during the July 2025 catastrophic flooding in central Texas.</p><p>It also extends gratitude to all members of the Coast Guard, other federal and state agencies, first responders, and volunteers who risked their lives to protect and rescue others.</p>",
        "update_date": "2026-04-03T17:00:02Z"
      }
