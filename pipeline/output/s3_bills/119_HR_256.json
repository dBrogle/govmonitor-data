    "summaries": [
      {
        "action_date": "2025-01-09",
        "action_desc": "Introduced in House",
        "text": "<p><strong>Save America\u2019s Valuable Energy Act or the SAVE Act</strong></p><p>This bill directs the Department of Energy to prohibit the sale of petroleum products (e.g., crude oil) from the Strategic Petroleum Reserve to entities headquartered in Russia,&nbsp;Belarus, Burma, China, Cuba, Iran, North Korea, Syria, or&nbsp;Venezuela.</p>",
        "update_date": "2025-03-27T12:31:13Z"
      }
