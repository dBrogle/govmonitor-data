    "summaries": [
      {
        "action_date": "2025-01-03",
        "action_desc": "Introduced in House",
        "text": "<p><strong>Byron Nash Renal Medullary Carcinoma Awareness Act of </strong><strong>2023&nbsp;[<em>sic</em>]</strong></p><p>This bill allows states to receive federal payment under Medicaid for 50% of their costs for providing education on the risk of renal medullary carcinoma to individuals with sickle cell disease. (Renal medullary carcinoma is a rare kidney disease usually found in individuals with the sickle cell trait.)</p>",
        "update_date": "2025-03-18T16:16:45Z"
      }
    ]
