    "summaries": [
      {
        "action_date": "2025-02-21",
        "action_desc": "Introduced in House",
        "text": "<p><b>Due Process Continuity of Care Act</b></p> <p>This bill allows an otherwise eligible individual who&nbsp;is in custody pending disposition of charges (i.e., pretrial detainees) to receive Medicaid benefits at the option of the state. The bill also provides for state planning grants to support the provision of such benefits.</p>",
        "update_date": "2025-03-26T19:34:09Z"
      }
    ]
