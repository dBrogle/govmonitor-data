      "title": "Stopping Wasteful Allowances for Lawmaker Wrongdoing and Ensuring Legal Liability Act",
      "title_type": "Short Title(s) as Introduced",
      "title_type_code": 101,
      "chamber": null,
      "bill_text_version_name": "Introduced in House",
