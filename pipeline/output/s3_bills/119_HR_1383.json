    "summaries": [
      {
        "action_date": "2025-02-14",
        "action_desc": "Introduced in House",
        "text": "<p><strong>Secure Rural Schools Reauthorization Act of 2025</strong></p><p>This bill extends and modifies the Secure Rural Schools and Community Self-Determination Act of 2000, including by</p><ul><li>extending payments made to states and counties containing federal land through FY2026,</li><li>providing for payments for FY2024 and FY2025,</li><li>extending the authority of counties to initiate projects using such funds through FY2028, and</li><li>extending the authority to initiate projects proposed by resource advisory committees through FY2028.</li></ul>",
        "update_date": "2025-12-19T21:57:07Z"
      }
    ]
  },
