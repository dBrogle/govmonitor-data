    "summaries": [
      {
        "action_date": "2025-03-06",
        "action_desc": "Introduced in House",
        "text": "<p>This joint resolution nullifies the final rule issued by the Consumer Financial Protection Bureau titled <em>Prohibition on Creditors and Consumer Reporting Agencies Concerning Medical Information (Regulation V)&nbsp;</em>and published on January 14, 2025. This rule prohibits the inclusion of medical debt on credit reports and prohibits creditors from considering medical debt when making credit eligibility determinations.&nbsp;</p>",
        "update_date": "2026-01-15T22:39:55Z"
      }
    ]
  },
