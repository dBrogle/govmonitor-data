    "summaries": [
      {
        "action_date": "2025-04-01",
        "action_desc": "Introduced in House",
        "text": "<p><strong></strong><strong><strong></strong></strong><strong>Reentry Act of 2025</strong></p><p>This bill allows for Medicaid payment of medical services furnished&nbsp;to an&nbsp;incarcerated individual&nbsp;during the 30-day period preceding the individual's release. The Medicaid and Children's Health Insurance Program (CHIP) Payment and Access Commission must report on specified information relating to the accessibility and quality of health care for incarcerated individuals, including the impact of the bill's changes.</p>",
        "update_date": "2025-04-18T17:56:40Z"
      }
    ]
