    "summaries": [
      {
        "action_date": "2025-11-10",
        "action_desc": "Introduced in House",
        "text": "<p><strong>Stuck On Hold Act</strong></p><p>This bill requires the Department of Veterans Affairs (VA) to implement automated systems for their customer phone lines that inform callers of the expected wait time and that offer callbacks for wait times of more than 10 minutes. The&nbsp;VA must also issue guidance to reduce the average wait time to no more than 10 minutes.</p>",
        "update_date": "2026-04-09T21:13:26Z"
      }
    ]
  },
