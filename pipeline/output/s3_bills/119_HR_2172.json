    "summaries": [
      {
        "action_date": "2025-03-18",
        "action_desc": "Introduced in House",
        "text": "<p><strong>Preserving Patient Access to Home Infusion Act&nbsp;</strong></p><p>This bill specifically includes pharmacy services and home infusion drugs that are administered&nbsp;without a pump as part of covered home infusion therapy under Medicare. The bill also allows nurses and physician assistants to establish and review the plan of care for home infusion therapy, and it specifies that payment may be made regardless of whether a practitioner is physically present in the home at the time the drug is administered.&nbsp;</p>",
        "update_date": "2026-03-11T21:56:31Z"
      }
    ]
  },
