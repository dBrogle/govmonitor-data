    "summaries": [
      {
        "action_date": "2025-01-13",
        "action_desc": "Introduced in House",
        "text": "<p><strong>Make Greenland Great Again Act</strong></p><p>This bill authorizes the President to seek to enter into negotiations with Denmark to acquire Greenland.</p><p>If such an agreement is reached, the President must transmit the agreement and related materials to Congress within five calendar days.&nbsp;The agreement shall go into effect 60 calendar days after such transmission unless Congress enacts a joint resolution of disapproval.</p>",
        "update_date": "2025-02-27T19:54:41Z"
      }
    ]
