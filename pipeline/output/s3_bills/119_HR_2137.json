    "summaries": [
      {
        "action_date": "2025-03-14",
        "action_desc": "Introduced in House",
        "text": "<p><strong>Review Every Veterans Claim Act of 2025</strong></p><p>This bill prohibits the Department of Veterans Affairs (VA) from denying a claim for benefits on the sole basis that a veteran failed to appear for a medical examination provided by the VA in conjunction with the claim for benefits.</p>",
        "update_date": "2025-06-16T19:57:16Z"
      }
    ]
