    "summaries": [
      {
        "action_date": "2025-01-09",
        "action_desc": "Introduced in House",
        "text": "<p><strong>SALT Fairness for Working Families Act</strong></p><p>This bill increases the limitation on the federal tax deduction for state and local taxes (commonly known as the SALT deduction cap) to $15,000 ($30,000 for married individuals filing a joint federal income tax return).&nbsp;</p><p>Under current law, the SALT deduction cap is $10,000 ($5,000 for a married individuals filing separate federal income tax returns).</p>",
        "update_date": "2025-02-13T17:17:08Z"
      }
    ]
