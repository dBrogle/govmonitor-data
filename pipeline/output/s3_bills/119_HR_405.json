    "summaries": [
      {
        "action_date": "2025-01-15",
        "action_desc": "Introduced in House",
        "text": "<p><strong>Keep Every Extra Penny Act of 2025</strong></p><p>This bill excludes from gross income for federal income tax purposes overtime compensation paid for hours worked in excess of 40 hours per week (as required by the Fair Labor Standards Act of 1938).&nbsp;Under current law, overtime compensation paid to a taxpayer is included in gross income for purposes of calculating federal income taxes.</p>",
        "update_date": "2025-03-25T15:48:38Z"
      }
    ]
