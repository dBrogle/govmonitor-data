    "summaries": [
      {
        "action_date": "2025-07-15",
        "action_desc": "Reported to House",
        "text": "<p><strong>Securities Research Modernization Act</strong></p><p>This bill allows a securities broker or dealer to publish or distribute a research report on a proposed public offering by any issuer without it being considered an offer to sell securities for purposes of registration requirements. Currently, only reports published or distributed regarding a proposed public offering by an emerging growth company fall under this exception.</p>",
        "update_date": "2025-09-03T15:37:57Z"
      }
    ]
  },
