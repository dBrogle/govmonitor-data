    "summaries": [
      {
        "action_date": "2025-01-21",
        "action_desc": "Introduced in House",
        "text": "<p><strong>Studying NEPA\u2019s Impact on Projects Act</strong></p><p>This bill directs the Council on Environmental Quality (CEQ) to annually report on the impact of the National Environmental Policy Act of 1969 (NEPA) on projects that require NEPA review. CEQ must publish the report on its website and submit it to certain congressional committees. The report must include</p><ul><li>specified information about NEPA litigation, such as the number of cases, the status of cases, and their outcomes;</li><li>the length and costs of the environmental impact statements&nbsp;and environmental assessments prepared; and&nbsp;</li><li>the time it takes to complete environmental reviews under NEPA.</li></ul>",
        "update_date": "2025-08-05T21:16:18Z"
      }
    ]
  },
