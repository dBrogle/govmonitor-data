    "summaries": [
      {
        "action_date": "2025-09-30",
        "action_desc": "Introduced in House",
        "text": "<p><strong></strong>This resolution expresses that the House of Representatives mourns the loss of the victims of the flooding in central Texas on July 4, 2025, honors the individuals who responded, and supports rebuilding infrastructure and providing assistance for those affected by the flooding.</p>",
