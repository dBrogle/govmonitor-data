    "summaries": [
      {
        "action_date": "2025-03-06",
        "action_desc": "Introduced in House",
        "text": "<p><strong>Simplifying Veterans Assistance Act of 2025</strong></p><p>This bill requires the Department of Veterans Affairs to provide specified guidance to entities seeking grants for the provision of comprehensive service programs to homeless veterans (e.g., rehabilitative services). Specifically, the VA must provide guidance and best practices on a publicly available VA website. Additionally, after the announcement of a funding notice and before the application deadline, the VA must offer at least two online information sessions for entities seeking grants.&nbsp;</p>",
        "update_date": "2025-06-16T19:42:13Z"
      }
    ]
