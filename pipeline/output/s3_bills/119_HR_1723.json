    "summaries": [
      {
        "action_date": "2025-02-27",
        "action_desc": "Introduced in House",
        "text": "<p><strong>Tribal Labor Sovereignty Act of </strong><strong>2025</strong></p><p>This bill excludes Indian tribes and tribal enterprises and institutions on tribal land from requirements for employers under the National Labor Relations Act (NLRA). (Currently under the NLRA, employers may not engage in unfair labor practices and must allow employees to form unions, engage in collective bargaining, and take collective action.)</p>",
        "update_date": "2025-07-10T16:22:22Z"
      }
    ]
