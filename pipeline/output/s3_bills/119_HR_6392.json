    "summaries": [
      {
        "action_date": "2026-02-10",
        "action_desc": "Reported to House",
        "text": "<p><strong>Home School Graduation Recognition Act</strong></p><p>This bill clarifies that students who complete their secondary education in a home school setting recognized under state law are&nbsp;high school graduates for purposes of eligibility for federal student aid.</p>",
        "update_date": "2026-02-26T19:18:48Z"
