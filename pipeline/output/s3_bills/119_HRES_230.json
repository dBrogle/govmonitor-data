    "summaries": [
      {
        "action_date": "2025-03-18",
        "action_desc": "Introduced in House",
        "text": "<p>This resolution expresses the sense of Congress that Congress and the Administration must work together to pursue effective food and agricultural trade policies that include specified components. Among others, these components include (1) a renewed commitment to secure market access and maintain global competitiveness for the U.S. food and agriculture industries; and (2) consideration of comprehensive trade agreements, enforcement of existing trade agreements, and elimination of certain&nbsp;nontariff trade barriers.</p>",
        "update_date": "2025-09-09T12:52:10Z"
      }
    ]
