    "summaries": [
      {
        "action_date": "2025-01-15",
        "action_desc": "Introduced in House",
        "text": "<p><strong>Miracle on Ice Congressional Gold Medal Act</strong></p><p>This bill provides for the award of Congressional Gold Medals to the members of the 1980 U.S. Olympic men's ice hockey team in recognition of the team's achievement at the 1980 Winter Olympic Games.</p>",
        "update_date": "2025-04-23T19:23:48Z"
      },
      {
