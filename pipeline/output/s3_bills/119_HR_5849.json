    "summaries": [
      {
        "action_date": "2025-10-28",
        "action_desc": "Introduced in House",
        "text": "<p><strong>Uninterrupted Salaries for Capitol Police Act or the USCP Act</strong></p><p>This bill provides appropriations for the salaries and expenses of employees of the U.S. Capitol Police during any lapse in discretionary appropriations (i.e., government shutdown) that begins on or after the date that this bill is enacted.&nbsp;</p>",
        "update_date": "2025-11-03T14:19:17Z"
      }
    ]
