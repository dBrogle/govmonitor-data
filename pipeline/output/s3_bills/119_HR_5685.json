    "summaries": [
      {
        "action_date": "2025-10-03",
        "action_desc": "Introduced in House",
        "text": "<p><strong>Personal Needs Allowance Modernization Act or the PNA Modernization Act&nbsp;</strong></p><p>This bill increases the minimum monthly personal needs allowance under Medicaid for an institutionalized individual and couple from $30 to $60 and from $60 to $120, respectively. (The personal needs allowance is deducted from an individual's total income when determining the individual's contribution to the cost of institutionalized care under Medicaid.)</p>",
        "update_date": "2026-01-15T22:56:21Z"
      }
    ]
