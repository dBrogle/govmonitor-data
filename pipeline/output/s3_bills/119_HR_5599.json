    "summaries": [
      {
        "action_date": "2025-09-26",
        "action_desc": "Introduced in House",
        "text": "<p>This bill prohibits the removal of federal employees from the civil service during a government shutdown due to a lapse in discretionary appropriations. If an employee is removed from the civil service in violation of this bill, the employee may elect to be reinstated with back pay on the&nbsp;date on which the lapse in appropriations ends.&nbsp;</p>",
        "update_date": "2025-10-07T13:20:10Z"
      }
    ]
