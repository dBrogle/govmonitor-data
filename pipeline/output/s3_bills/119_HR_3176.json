    "summaries": [
      {
        "action_date": "2025-09-15",
        "action_desc": "Reported to House",
        "text": "<p>This bill reauthorizes through FY2030 the National Volcano Early Warning and Monitoring System of the&nbsp;U.S. Geological Survey (USGS).&nbsp;</p><p>The system, implemented by the USGS in collaboration with the National Oceanic and Atmospheric Administration, includes a monitoring network, volcano observatories, a national data center, and external research grants.</p>",
        "update_date": "2025-12-11T16:39:02Z"
      }
