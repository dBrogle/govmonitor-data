    "summaries": [
      {
        "action_date": "2025-01-03",
        "action_desc": "Introduced in House",
        "text": "<p><strong>Hershel \"Woody\" Williams National Medal of Honor Monument Location Act</strong></p><p>This bill requires the authorized monument&nbsp;honoring Medal of Honor recipients to be located within the Reserve (the great cross-axis of the National Mall, which generally extends from the Capitol to the Lincoln Memorial and from the White House to the Jefferson Memorial).</p>",
        "update_date": "2025-01-31T20:53:22Z"
      }
    ]
