    "summaries": [
      {
        "action_date": "2025-02-06",
        "action_desc": "Introduced in House",
        "text": "<p><strong>Filipino Veterans Family Reunification Act of 2025 </strong></p><p>This bill exempts from immigrant visa limitations the children of certain individuals who were naturalized due to their military service during World War II. Specifically, this applies to the children of veterans who served honorably during World War II in the U.S. Armed Forces or in Filipino military units such as the Philippine Army, Philippine Scouts, or recognized guerilla units.</p>",
        "update_date": "2025-07-10T15:13:42Z"
      }
    ]
  },
