    "summaries": [
      {
        "action_date": "2025-01-22",
        "action_desc": "Introduced in House",
        "text": "<p><strong>Close the Medigap Act of 2025</strong><strong></strong></p><p>This bill (1) expands guaranteed issue rights with respect to Medigap policies (Medicare supplemental health insurance policies), (2) eliminates certain limitations&nbsp;on Medigap policies for newly eligible Medicare beneficiaries, and (3) modifies other provisions related to Medigap policies. (Guaranteed issue rights require that a policy be offered to any eligible applicant without regard to health status.)</p>",
        "update_date": "2025-03-10T16:46:42Z"
      }
    ]
  },
