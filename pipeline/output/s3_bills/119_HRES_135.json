    "summaries": [
      {
        "action_date": "2025-02-13",
        "action_desc": "Introduced in House",
        "text": "<p>This resolution reaffirms the House of Representatives' full and unwavering commitment to the North Atlantic Treaty Organization (NATO). The resolution also (1) reaffirms NATO's open door policy and the right of every state, including Ukraine, to choose its own security arrangements; and (2) underscores the importance of NATO allies dedicating at least 2% of their gross domestic product to national defense or establishing plans to meet that obligation.</p>",
        "update_date": "2025-03-19T18:46:09Z"
