    "summaries": [
      {
        "action_date": "2025-03-27",
        "action_desc": "Introduced in House",
        "text": "<p><strong>Portable Ultrasound Reimbursement Equity Act of 2025</strong></p><p>This bill provides for Medicare coverage of ultrasound tests performed&nbsp;at a beneficiary's home. The Centers for Medicare &amp; Medicaid Services must provide for separate payments for portable ultrasound services in the same manner and to the same extent as for portable X-ray services.</p>",
        "update_date": "2026-04-14T17:47:00Z"
      }
    ]
