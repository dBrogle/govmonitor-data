    "summaries": [
      {
        "action_date": "2025-01-09",
        "action_desc": "Introduced in House",
        "text": "<p><strong>Panama Canal Repurchase Act of 2025</strong></p><p>This bill authorizes the President to negotiate with the appropriate Panamanian government officials to reacquire the Panama Canal. The President must submit a report to Congress within 180 days of enactment detailing the progress of such negotiations, potential challenges, and anticipated outcomes.&nbsp;</p>",
        "update_date": "2025-02-10T15:06:50Z"
      }
    ]
