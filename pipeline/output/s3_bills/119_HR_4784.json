    "summaries": [
      {
        "action_date": "2025-07-29",
        "action_desc": "Introduced in House",
        "text": "<p><strong>Don Young American Grown Act</strong></p><p>This bill prohibits the official display of a cut flower or green in any public area of a building of the Executive Office of the President, the Department of State, or the Department of Defense unless it is grown in the United States.</p><p>The prohibition does not apply to any cut flower or green used by a federal officer or employee for personal display.</p>",
        "update_date": "2026-03-31T15:03:49Z"
      }
    ]
  },
