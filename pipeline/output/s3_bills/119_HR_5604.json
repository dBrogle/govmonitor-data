    "summaries": [
      {
        "action_date": "2025-09-26",
        "action_desc": "Introduced in House",
        "text": "<p><strong>National Guard Proper Use Act</strong></p><p>This bill&nbsp;prohibits,&nbsp;in accordance with the Posse Comitatus Act, members of the Armed Forces and members of the National Guard from being ordered to enforce immigration laws. Generally, the Posse&nbsp;Comitatus Act prohibits the use of the military for civil law enforcement purposes.</p>",
        "update_date": "2026-06-03T21:16:19Z"
      }
    ]
