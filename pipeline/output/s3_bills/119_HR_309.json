    "summaries": [
      {
        "action_date": "2025-01-09",
        "action_desc": "Introduced in House",
        "text": "<p><strong>National Law Enforcement Officers Remembrance, Support and Community Outreach Act. [<em>sic</em>]</strong></p><p>This&nbsp;bill temporarily&nbsp;directs the Department of the Interior&nbsp;to award a grant to the National Law Enforcement Officers Memorial Fund for the expenses associated with operating and enhancing the community outreach, public education, and officer safety and wellness programs of the National Law Enforcement Museum.</p>",
        "update_date": "2025-04-22T20:05:15Z"
      }
    ]
