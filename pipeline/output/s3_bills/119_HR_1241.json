    "summaries": [
      {
        "action_date": "2025-02-12",
        "action_desc": "Introduced in House",
        "text": "<p><strong>Security And Fairness Enhancement for America Act of 2025 or SAFE for America Act of 2025</strong></p><p>This bill eliminates the diversity visa program. This program provides up to 55,000 visas annually to individuals from countries with low rates of immigration to the United States.&nbsp;</p>",
        "update_date": "2026-03-04T01:39:43Z"
      }
    ]
