    "summaries": [
      {
        "action_date": "2025-09-18",
        "action_desc": "Introduced in House",
        "text": "<p>This resolution officially recognizes the Suicide Awareness and Remembrance flag and designates the flag as the symbol of awareness of military and veteran suicide and the commitment to resolve military and veteran suicide. The resolution also remembers and honors the servicemembers and veterans who have died by suicide and commits to posting the flag above all federal buildings wherever there is an American flag and POW/MIA flag. Further, the resolution supports the designation of a National Veterans Suicide Awareness and Remembrance Day.</p>",
        "update_date": "2026-04-07T21:02:35Z"
      }
    ]
