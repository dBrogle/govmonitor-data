    "summaries": [
      {
        "action_date": "2025-04-10",
        "action_desc": "Introduced in House",
        "text": "<p><strong>Chaco Cultural Heritage Area Protection Act of 2025</strong></p><p>This bill creates a buffer zone around the Chaco Culture National Historic Park in New Mexico by prohibiting certain leases on federal land for the development of mineral resources or geothermal energy within the buffer zone. Nonproducing oil and gas leases in the buffer zone are terminated.</p>",
        "update_date": "2026-03-27T01:30:12Z"
      }
    ]
