    "summaries": [
      {
        "action_date": "2025-01-15",
        "action_desc": "Introduced in House",
        "text": "<p><strong>Combating High Inflation Limiting Daycare Act of 2025 or the CHILD Act of 2025</strong></p><p>This bill increases the maximum annual amount that may be contributed to a dependent care assistance program (generally known as a dependent care flexible spending account [FSA]).</p><p>Under the bill, the maximum annual amount that may be contributed to a dependent care&nbsp;FSA increases from $5,000 ($2,500 for married taxpayers who file separate federal tax returns) to $10,000 ($5,000 for married taxpayers who file separate federal tax returns) and is adjusted annually for inflation.</p>",
        "update_date": "2025-03-24T14:17:13Z"
      }
    ]
  },
