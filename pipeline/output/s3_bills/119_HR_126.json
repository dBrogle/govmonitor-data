    "summaries": [
      {
        "action_date": "2025-01-03",
        "action_desc": "Introduced in House",
        "text": "<p><strong>Original Students Voicing Opinions in Today's Elections (VOTE) Act</strong></p><p>This bill directs the Election Assistance Commission to carry out a pilot program providing funds, during FY2025, to local educational agencies (LEAs) for initiatives that provide 12th graders with voter registration information.</p><p>LEAs must consult with their state and local election officials in developing the initiatives.</p>",
        "update_date": "2025-02-03T15:30:33Z"
      }
    ]
