    "summaries": [
      {
        "action_date": "2025-03-18",
        "action_desc": "Introduced in House",
        "text": "<p><strong>Healthy Foods for Native Seniors Act</strong></p><p>This bill directs the Department of Agriculture to establish a demonstration project that allows tribal entities (e.g., Indian tribes) to enter into self-determination contracts to purchase agricultural commodities under&nbsp;the Commodity Supplemental Food Program (CSFP).&nbsp;The&nbsp;CSFP distributes monthly food packages to low-income older individuals through local organizations (including tribal organizations).</p>",
        "update_date": "2026-06-12T14:13:46Z"
      }
