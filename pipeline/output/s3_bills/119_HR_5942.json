    "summaries": [
      {
        "action_date": "2025-11-07",
        "action_desc": "Introduced in House",
        "text": "<p><strong>National Cemetery Access Act</strong></p><p>This bill requires that national cemeteries administered by the Department of Defense, Department of Veterans Affairs, or the National Park Service must be open to visitors on the 11 legal public holidays (e.g., Memorial Day).</p>",
        "update_date": "2026-04-24T22:24:28Z"
      }
