    "summaries": [
      {
        "action_date": "2025-02-07",
        "action_desc": "Introduced in House",
        "text": "<p><strong>East Palestine Health Impact Monitoring Act of 2025</strong></p><p>This bill requires the Department of Health and Human Services  to provide a grant to a consortium of institutions of higher education to conduct&nbsp;a long-term study  on any human health effects from the train derailment (and subsequent venting and burning of chemicals) in East Palestine, Ohio, on February 3, 2023.&nbsp;</p>",
        "update_date": "2025-06-09T18:18:16Z"
      }
    ]
