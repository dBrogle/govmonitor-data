    "summaries": [
      {
        "action_date": "2025-07-25",
        "action_desc": "Introduced in House",
        "text": "<p><strong>Freights First Act</strong></p><p>This bill eliminates Amtrak's preference over freight transportation in using a rail line, junction, or crossing if such rail line, junction, or crossing is located within 50 miles of a port or rail yard. Currently, Amtrak's priority status does not apply if there is&nbsp;an emergency.</p>",
        "update_date": "2025-09-15T10:16:24Z"
      }
    ]
