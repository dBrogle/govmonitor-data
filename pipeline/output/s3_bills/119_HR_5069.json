    "summaries": [
      {
        "action_date": "2025-08-29",
        "action_desc": "Introduced in House",
        "text": "<p><strong>Peter J. McGuire Labor Day Landmark Act</strong></p><p>This bill designates the Peter J. McGuire Memorial and Peter J. McGuire Gravesite in Pennsauken, New Jersey, as the Peter J. McGuire Memorial National Commemorative Site.</p><p>The Department of the Interior may enter into cooperative agreements to provide the public with educational and interpretive facilities and programs concerning the commemorative site. Interior may also&nbsp;provide technical and financial assistance to any entity with which it has&nbsp;entered into such cooperative agreement.</p>",
        "update_date": "2026-04-07T13:02:59Z"
      }
    ]
