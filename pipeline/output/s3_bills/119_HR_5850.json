    "summaries": [
      {
        "action_date": "2025-10-28",
        "action_desc": "Introduced in House",
        "text": "<p><strong>Guaranteeing Retention and Aid During Shutdowns Act or the GRAD Act</strong></p><p>This bill prohibits institutions of higher education&nbsp;that participate in federal student aid programs from terminating or otherwise altering the enrollment status of a student due to a disruption of the student\u2019s federal student financial aid caused by a lapse in appropriations (i.e., government shutdown).</p>",
        "update_date": "2025-11-03T14:35:13Z"
      }
    ]
