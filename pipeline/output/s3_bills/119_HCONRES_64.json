    "summaries": [
      {
        "action_date": "2025-12-01",
        "action_desc": "Introduced in House",
        "text": "<p>This concurrent resolution directs the President to remove U.S. Armed Forces from hostilities within or against Venezuela unless a declaration of war or authorization to use military force for such purpose has been enacted.</p>",
