    "summaries": [
      {
        "action_date": "2025-02-05",
        "action_desc": "Introduced in House",
        "text": "<p><strong>Montgomery GI Bill Selected Reserves Tuition Fairness Act of 2025</strong></p><p>This bill requires that the Department of Veterans Affairs disapprove courses of education provided by educational institutions that charge higher than in-state tuition for individuals utilizing the Montgomery GI Bill-Selected Reserve education benefits while living in the state where the education is located, regardless of the individual\u2019s state of residence.</p>",
        "update_date": "2025-03-24T17:24:51Z"
      },
      {
        "action_date": "2025-12-12",
        "action_desc": "Public Law",
        "text": "<p><strong>Montgomery GI Bill Selected Reserves Tuition Fairness Act of 2025</strong></p><p>This act requires that the Department of Veterans Affairs disapprove courses of education provided by educational institutions that charge higher than in-state tuition for individuals utilizing the Montgomery GI Bill-Selected Reserve education benefits while living in the state where the education is located, regardless of the individual\u2019s state of residence.</p>",
        "update_date": "2026-04-10T12:43:35Z"
