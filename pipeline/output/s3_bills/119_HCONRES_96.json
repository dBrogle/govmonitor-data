    "summaries": [
      {
        "action_date": "2026-05-07",
        "action_desc": "Introduced in House",
        "text": "<p>This concurrent resolution expresses support for law enforcement officers. It also appreciates the contributions and recognizes the sacrifices of law enforcement officers.</p>",
