    "summaries": [
      {
        "action_date": "2025-04-07",
        "action_desc": "Introduced in House",
        "text": "<p><strong>District of Columbia Electronic Transmittal of Legislation Act</strong></p><p>This bill authorizes the District of Columbia (DC) Council to transmit legislation, including amendments to the DC Charter, to Congress by electronic means. (Current law requires most nonemergency DC legislation to be transmitted to Congress for&nbsp;a period of congressional review.)</p>",
        "update_date": "2025-09-09T15:27:07Z"
