    "summaries": [
      {
        "action_date": "2025-11-07",
        "action_desc": "Introduced in House",
        "text": "<p><strong>Responsible Wildland Fire Recovery Act</strong></p><p>This bill authorizes the Department of Agriculture (USDA) to waive certain requirements for matching federal funds in fire recovery projects. Specifically, USDA may waive cost-sharing requirements for projects responding to fires resulting from management activities (e.g., controlled burns) conducted by USDA on National Forest System land.</p>",
        "update_date": "2026-04-09T21:12:01Z"
      }
    ]
