    "summaries": [
      {
        "action_date": "2025-09-15",
        "action_desc": "Introduced in House",
        "text": "<p><strong>Social Security Child Protection Act of 2025</strong></p><p>This bill directs the Social Security Administration to issue a new Social Security number to a child under the age of 14 if the child's Social Security card was lost or stolen while being mailed to the child.</p>",
        "update_date": "2025-11-26T20:16:49Z"
