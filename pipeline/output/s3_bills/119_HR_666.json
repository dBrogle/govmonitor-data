    "summaries": [
      {
        "action_date": "2025-01-23",
        "action_desc": "Introduced in House",
        "text": "<p><strong>Noncontiguous Shipping Reasonable Rate Act of &nbsp;2024</strong></p><p>This bill provides that a rate for service in noncontiguous domestic ocean trade is reasonable if such rate is within 10% of a rate set by a comparable international ocean rate index recognized by the Federal Maritime Commission. (Under current law, a rate is required to be reasonable, and the Surface Transportation Board generally has the authority to determine whether certain rates are reasonable.)</p>",
        "update_date": "2025-07-03T14:41:11Z"
      }
    ]
