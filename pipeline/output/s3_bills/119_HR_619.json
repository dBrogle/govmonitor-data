    "summaries": [
      {
        "action_date": "2025-01-22",
        "action_desc": "Introduced in House",
        "text": "<p><b>Nor Rel Muk Wintu Nation Federal Recognition Act</b></p> <p>This bill extends federal recognition to the Nor Rel Muk Wintu Nation.</p> <p>The bill makes the tribe and its members eligible for services and benefits provided to federally recognized tribes, without regard to the existence of a reservation or the location of the residence of any member. The service area of the tribe is considered to be Trinity County, California.</p> <p>The tribe must submit a membership roll to the Department of the Interior. The tribe must maintain the membership roll.</p>",
        "update_date": "2025-04-23T00:29:31Z"
      }
    ]
