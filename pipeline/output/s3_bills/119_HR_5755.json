    "summaries": [
      {
        "action_date": "2025-10-14",
        "action_desc": "Introduced in House",
        "text": "<p><strong>No Budget, No Pay Act</strong></p><p>This bill prohibits Members of Congress from being paid in a fiscal year until both chambers approve the budget resolution and pass all regular appropriations bills for that fiscal year. Retroactive pay is prohibited for such a period.&nbsp;</p>",
        "update_date": "2025-10-16T14:05:24Z"
      }
    ]
