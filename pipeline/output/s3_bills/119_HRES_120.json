    "summaries": [
      {
        "action_date": "2025-02-06",
        "action_desc": "Introduced in House",
        "text": "<p>This resolution condemns Azerbaijan for its treatment of Dr. Gubad Ibadoghlu, practice of wrongful detention,&nbsp;and&nbsp;suppression of academic freedom. The resolution also calls for Dr. Ibadoghlu's immediate and unconditional release and for the Department of State to prioritize his well-being and release in all engagements with Azerbaijan.</p>",
        "update_date": "2025-03-13T20:56:17Z"
      }
    ]
  },
