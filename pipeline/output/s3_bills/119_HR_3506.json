    "summaries": [
      {
        "action_date": "2025-05-20",
        "action_desc": "Introduced in House",
        "text": "<p><strong>Healthy Food Financing Initiative Reauthorization Act of 2025</strong></p><p>This bill reauthorizes and provides specified funds for the Department of Agriculture's Healthy Food Financing Initiative (HFFI) through FY2030 and for each fiscal year thereafter.</p><p>As background,&nbsp;HFFI provides loans, grants, and technical assistance resources to eligible healthy food retailers and food supply chain enterprises to improve and support access to fresh, healthy, and affordable food in urban and rural underserved communities.</p>",
        "update_date": "2025-06-26T16:27:53Z"
      }
    ]
