      {
        "action_date": "2025-05-23",
        "action_desc": "Introduced in House",
        "text": "<p><strong>Veterans Skilled Trades Transition Act</strong></p><p>This bill requires the Department of Defense (DOD) to submit a report to Congress that builds on data reported in a previous report titled <em>DoD Credentialing Utilization</em> (3-BB02A16) to better assess the effectiveness of DOD credentialing programs for post-military civilian employment.</p>",
        "update_date": "2026-03-27T13:51:30Z"
      }
