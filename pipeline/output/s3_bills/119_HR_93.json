    "summaries": [
      {
        "action_date": "2025-01-03",
        "action_desc": "Introduced in House",
        "text": "<p><strong>Stop Imposing Woke Ideology Abroad Act</strong></p><p>This bill prohibits using federal funds for the Department of State's Special Representative for Racial Equity and Justice. (The special representative's duties include leading the State Department's efforts to combat systemic racism and discrimination around the world.)</p><p>The bill also prohibits using federal funds to implement the State Department's Equity Action Plan. (The plan outlines actions and metrics related to addressing issues of equity, including racial equity, in the State Department's foreign affairs mission.)</p>",
        "update_date": "2025-02-04T13:10:53Z"
      }
    ]
