    "summaries": [
      {
        "action_date": "2025-11-12",
        "action_desc": "Introduced in House",
        "text": "<p><strong>Sgt. Walter F. Hartnett IV Green Star Veterans Service Act</strong></p><p>This bill requires the Department of Veterans Affairs to design and designate the Green Star Service Flag to identify next of kin of veterans who died of suicide on or after September 11, 2001. An individual who is next of kin of such a veteran may display the flag.</p>",
        "update_date": "2026-04-08T21:40:04Z"
      }
    ]
