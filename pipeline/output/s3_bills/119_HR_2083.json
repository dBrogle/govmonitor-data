    "summaries": [
      {
        "action_date": "2025-03-11",
        "action_desc": "Introduced in House",
        "text": "<p><strong>Veterans First Act of 2025</strong></p><p>This bill rescinds $2 billion of the unobligated funds that were provided to the U.S. Agency for International Development. It also provides $2 billion in appropriations to the Department of Veterans Affairs for grants to assist states to acquire or construct state nursing home and&nbsp;domiciliary facilities&nbsp;and to remodel, modify, or alter existing hospital, nursing home, and domiciliary facilities in state homes for furnishing care to veterans,&nbsp;</p>",
        "update_date": "2025-05-09T18:00:48Z"
      }
    ]
