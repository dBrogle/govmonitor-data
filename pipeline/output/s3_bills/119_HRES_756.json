    "summaries": [
      {
        "action_date": "2025-09-19",
        "action_desc": "Introduced in House",
        "text": "<p>This resolution</p><ul><li>expresses support for a National Voting Rights Month,</li><li>encourages people to uphold the right to vote,</li><li>encourages Congress to pass certain voting rights legislation,</li><li>recommends the development of a curriculum in public schools and universities regarding voting,</li><li>expresses appreciation for the U.S. Postal Service for issuing a special Representative John R. Lewis stamp, and</li><li>invites Congress to allocate funds for public service announcements regarding elections.</li></ul>",
        "update_date": "2026-06-08T18:31:53Z"
      }
    ]
