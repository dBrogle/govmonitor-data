    "summaries": [
      {
        "action_date": "2025-01-23",
        "action_desc": "Introduced in House",
        "text": "<p><strong>Medal of Honor Act</strong></p><p>This bill increases the monthly special pension for living Medal of Honor recipients from $1,406.73 to $8,333.33 and establishes a rate of $1,406.73 for the monthly special pension for surviving spouses of Medal of Honor recipients. Both amounts must be adjusted annually for inflation.</p>",
        "update_date": "2025-02-25T17:02:44Z"
      }
    ]
