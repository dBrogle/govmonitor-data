    "summaries": [
      {
        "action_date": "2025-01-21",
        "action_desc": "Introduced in House",
        "text": "<p>This bill removes the lesser prairie-chicken (<em>Tympanuchus pallidicinctus</em>), including each of its distinct population segments, from the threatened and endangered species lists that are published under the Endangered Species Act of 1973. Further, the bill prohibits the U.S. Fish and Wildlife Service from designating such species as threatened or endangered, and thus, protecting such species under such act.</p>",
        "update_date": "2025-07-28T13:57:42Z"
      }
    ]
