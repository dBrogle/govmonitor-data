    "summaries": [
      {
        "action_date": "2025-01-23",
        "action_desc": "Introduced in House",
        "text": "<p><strong>Veterans Law Judge Experience Act of 2025</strong></p><p>This bill requires the Chairman of the Board of Veterans\u2019 Appeals to prioritize individuals with three or more years of legal professional experience in relevant legal areas when recommending individuals to the Department of Veterans Affairs to serve as members of the Board.</p>",
        "update_date": "2025-03-11T15:50:20Z"
      }
    ]
