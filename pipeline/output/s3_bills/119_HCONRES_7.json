    "summaries": [
      {
        "action_date": "2025-01-28",
        "action_desc": "Introduced in House",
        "text": "<p>This concurrent resolution temporarily establishes a bipartisan and bicameral Task Force on the Legislative Process. The task force must analyze and&nbsp;report on ways to expedite the consideration of legislation that passed in its originating chamber with wide and bipartisan support.</p><p>The task force must submit a final report of its recommendations within one year of the passage of this concurrent resolution. Congress must make the report publicly available<strong>.</strong></p><p>The task force terminates upon the submission of the report.</p>",
        "update_date": "2025-03-14T20:32:59Z"
      }
    ]
