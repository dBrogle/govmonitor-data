    "summaries": [
      {
        "action_date": "2025-10-08",
        "action_desc": "Introduced in House",
        "text": "<p>This bill requires the federal government to reimburse state agencies that use state funds to carry out operations necessary to maintain participation in the Special Supplemental Nutrition Program for Women, Infants, and Children (WIC) during a lapse in discretionary appropriations (i.e., government shutdown). WIC&nbsp;provides nutrition-rich foods, nutrition education, and health care and social services referrals to eligible low-income women, infants, and children.</p>",
        "update_date": "2025-10-20T14:06:32Z"
      }
    ]
